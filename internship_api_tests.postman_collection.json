{
  "info": {
    "name": "Internship Application Tracker API (SW426)",
    "description": "Postman tests for the Internship Application Tracker REST API. Start the Flask server, then run the folders in order (Collection Runner). Variable baseUrl can be changed under the collection's Variables tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 CRUD tests",
      "item": [
        {
          "name": "TC-01 Create valid internship",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/internships",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "internships"
              ]
            },
            "description": "Objective: add a valid record. Expected: 201 Created and the saved record with an id. DB: one new row.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Example Tech {{runId}}\",\n  \"role\": \"Python Intern\",\n  \"application_date\": \"2026-10-14\",\n  \"status\": \"Applied\",\n  \"location\": \"Remote\",\n  \"notes\": \"Applied through the company website\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new runId keeps the test data unique, so the whole collection can be re-run.",
                  "pm.collectionVariables.set(\"runId\", String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Response has a numeric id and matches the data sent\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.company_name).to.eql(pm.variables.replaceIn(\"Example Tech {{runId}}\"));",
                  "    pm.expect(body.role).to.eql(\"Python Intern\");",
                  "    pm.expect(body.application_date).to.eql(\"2026-10-14\");",
                  "    pm.expect(body.status).to.eql(\"Applied\");",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    // Remember the real id for the next requests.",
                  "    pm.collectionVariables.set(\"recordId\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-02 Get all internships",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/internships",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "internships"
              ]
            },
            "description": "Objective: retrieve all records. Expected: 200 OK and a JSON array that contains the TC-01 record."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "let list = [];",
                  "try { list = pm.response.json(); } catch (e) {}",
                  "pm.test(\"Response is a JSON array\", function () {",
                  "    pm.expect(list).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Array contains the record created in TC-01\", function () {",
                  "    const ids = list.map(function (r) { return r.id; });",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"recordId\")));",
                  "});",
                  "// Remember the row count so TC-16 can prove the negative tests changed nothing.",
                  "pm.collectionVariables.set(\"rowCount\", list.length);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-03 Get one internship",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/internships/{{recordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "internships",
                "{{recordId}}"
              ]
            },
            "description": "Objective: retrieve one record by its real id. Expected: 200 OK and a single JSON object."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Record has the expected id and data\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"object\");",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"recordId\")));",
                  "    pm.expect(body.role).to.eql(\"Python Intern\");",
                  "    pm.expect(body.status).to.eql(\"Applied\");",
                  "});"
                ]
              }
            }
          ]
        },
